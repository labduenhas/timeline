{
  "name": "acervo-timeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"vite\" \"wrangler dev\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx",
    "worker:deploy": "wrangler deploy",
    "pages:deploy": "wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 execute acervo-db --local --file=./migrations/001_init.sql",
    "db:seed:local": "wrangler d1 execute acervo-db --local --file=./migrations/002_seed.sql",
    "db:migrate": "wrangler d1 execute acervo-db --remote --file=./migrations/001_init.sql"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.19",
    "hono": "^4.5.3",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240903.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "wrangler": "^3.72.0"
  }
}
